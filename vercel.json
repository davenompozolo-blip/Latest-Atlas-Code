{
  "framework": "vite",
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/claude-analyse.js":  { "maxDuration": 300 },
    "api/claude-sector.js":   { "maxDuration": 300 },
    "api/ledger-snapshot.js": { "maxDuration": 60 },
    "api/ledger-export.js":   { "maxDuration": 30 },
    "api/sync-valuations.js": { "maxDuration": 300 },
    "api/options-snapshot.js": { "maxDuration": 300 },
    "api/vol-dispersion-sync.js": { "maxDuration": 300 },
    "api/theme-leadership-snapshot.js": { "maxDuration": 60 },
    "api/trade-sync.js": { "maxDuration": 300 },
    "api/price-backfill.js": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options",        "value": "DENY" }
      ]
    }
  ]
}
